pipeline {
    agent any

    options {
        // 防止同一任务并发写入会话文件和日志目录。
        disableConcurrentBuilds()
        // 仅保留必要的构建记录和日志归档，避免长期占用 Jenkins 磁盘。
        buildDiscarder(logRotator(numToKeepStr: '15', artifactNumToKeepStr: '7'))
    }

    parameters {
        string(
            name: 'PROJECT_ID',
            defaultValue: 'truthy',
            description: '工具项目包 ID，例如 truthy 或 dating；兼容旧任务时缺省 truthy'
        )
        choice(
            name: 'RUN_TYPE',
            choices: ['all', 'single', 'flow'],
            description: 'all=全部，single=单接口，flow=多接口流程'
        )
        string(
            name: 'FLOW',
            defaultValue: '',
            description: '可选 Flow 文件名，不含 .yaml；留空执行全部 Flow'
        )
        string(
            name: 'PLATFORM_TASK_ID',
            defaultValue: '',
            description: '平台派发的根任务 ID；报告归属校验必填，不允许人工改绑'
        )
    }

    // 自动定时触发已暂停；恢复时再按原规则增加 triggers/cron 配置。

    environment {
        PROJECT_DIR = 'Truthy_ApiAutoTest2'
        // 固定 Allure 版本，确保本地与 Jenkins 生成结果的方式一致。
        ALLURE_VERSION = '3.14.3'
        // Jenkins 节点未安装 Node 时，在任务工作区准备固定且经过校验的版本。
        NODE_VERSION = '22.23.2'
        NODE_SHA256 = '61130f394c1630d211dd50aecc4353d379480f36d3ac913cd85dbba1aed585c6'
    }

    stages {
        stage('校验平台任务身份') {
            steps {
                sh '''
                    set -eu
                    printf '%s' "${PLATFORM_TASK_ID:-}" | \
                        LC_ALL=C grep -Eq '^[0-9]{8}-[0-9]{6}-[0-9a-f]{4}$' || {
                            echo "PLATFORM_TASK_ID 缺失或格式非法"
                            exit 2
                        }
                '''
            }
        }

        stage('准备 Python 环境') {
            steps {
                dir("${PROJECT_DIR}") {
                    sh '''
                        set -eu
                        python3 -m venv .venv
                        .venv/bin/python -m pip install \
                            --disable-pip-version-check \
                            -r requirements.txt
                        .venv/bin/python runtest.py --validate-projects

                        # 正式 Jenkins 任务与 Web 平台任务遵循同一配置边界：
                        # 快照必须由触发方通过 Jenkins Secret File 绑定注入，且
                        # loader 会校验 0600、项目、环境和平台任务 ID。缺失或
                        # 契约不完整时在 pytest 收集前失败，绝不回退 YAML/.env。
                        PROJECT_ID="${PROJECT_ID:-truthy}"
                        # PLATFORM_ENVIRONMENT 由 dev/prod Jenkins 部署配置，
                        # 不是构建参数；工具使用者不能跨环境覆盖 target env。
                        PLATFORM_ENVIRONMENT="${PLATFORM_ENVIRONMENT:-dev}"
                        case "$PLATFORM_ENVIRONMENT" in
                            dev) TARGET_ENV="test" ;;
                            prod) TARGET_ENV="prod" ;;
                            *)
                                echo "不支持的平台环境: $PLATFORM_ENVIRONMENT"
                                exit 2
                                ;;
                        esac
                        [ -n "${API_AUTOTEST_RUNTIME_SNAPSHOT_FILE:-}" ] || {
                            echo "缺少平台运行快照文件绑定 API_AUTOTEST_RUNTIME_SNAPSHOT_FILE"
                            exit 2
                        }
                        [ -f "$API_AUTOTEST_RUNTIME_SNAPSHOT_FILE" ] || {
                            echo "平台运行快照文件不存在"
                            exit 2
                        }
                        .venv/bin/python - "$PROJECT_ID" "$TARGET_ENV" "$PLATFORM_TASK_ID" "$PLATFORM_ENVIRONMENT" <<'PYEOF'
from pathlib import Path
import sys

from utils.custom.config_loader import load_settings, validate_settings_contract
from utils.custom.project_registry import ProjectRegistry

project_id, target_env, task_id, platform_environment = sys.argv[1:]
root = Path.cwd()
package = ProjectRegistry(root / "projects").get(project_id)
settings = load_settings(
    target_env,
    project_root=root,
    config_source="platform",
    project_id=project_id,
    task_id=task_id,
)
validate_settings_contract(
    settings,
    package.manifest.config_contract.required_keys,
)
runtime_metadata = settings.get("runtime_metadata") or {}
if runtime_metadata.get("platform_environment") != platform_environment:
    raise SystemExit("平台快照与当前 Jenkins 部署环境不一致")
print(
    f"平台快照预检通过: project={project_id} "
    f"platform={platform_environment} target_env={target_env}"
)
PYEOF
                    '''
                }
            }
        }

        stage('执行接口自动化') {
            steps {
                dir("${PROJECT_DIR}") {
                    sh '''
                        set -eu
                        # 首次构建尚未注册参数环境变量，使用参数声明中的默认值继续执行。
                        if [ -z "${PROJECT_ID:-}" ]; then
                            echo "弃用提示：旧任务未提供 PROJECT_ID，兼容期默认使用 truthy"
                        fi
                        PROJECT_ID="${PROJECT_ID:-truthy}"
                        PLATFORM_ENVIRONMENT="${PLATFORM_ENVIRONMENT:-dev}"
                        case "$PLATFORM_ENVIRONMENT" in
                            dev) TARGET_ENV="test" ;;
                            prod) TARGET_ENV="prod" ;;
                            *)
                                echo "不支持的平台环境: $PLATFORM_ENVIRONMENT"
                                exit 2
                                ;;
                        esac
                        RUN_TYPE="${RUN_TYPE:-all}"
                        FLOW="${FLOW:-}"

                        REPORT_ROOT="reports/task-reports/$PROJECT_ID/$PLATFORM_TASK_ID"
                        JUNIT_FILE="reports/junit/$PROJECT_ID/$PLATFORM_TASK_ID.xml"
                        ALLURE_RESULTS="$REPORT_ROOT/allure-results"
                        mkdir -p "$(dirname "$JUNIT_FILE")" "$REPORT_ROOT"
                        rm -f "$JUNIT_FILE"
                        rm -rf "$ALLURE_RESULTS"

                        run_single() {
                            .venv/bin/python -m pytest \
                                test_cases/test_single_api.py \
                                --project="$PROJECT_ID" \
                                --target-env="$TARGET_ENV" \
                                --config-source=platform \
                                --task-id="$PLATFORM_TASK_ID" \
                                -s \
                                --log-cli-level=INFO \
                                --junitxml="$JUNIT_FILE" \
                                --alluredir="$ALLURE_RESULTS" \
                                --clean-alluredir \
                                --allure-no-capture
                        }

                        run_flow() {
                            if [ -n "$FLOW" ]; then
                                .venv/bin/python -m pytest \
                                    test_cases/test_gateway_flow.py \
                                    --project="$PROJECT_ID" \
                                    --target-env="$TARGET_ENV" \
                                    --config-source=platform \
                                    --task-id="$PLATFORM_TASK_ID" \
                                    --flow="$FLOW" \
                                    -s \
                                    --log-cli-level=INFO \
                                    --junitxml="$JUNIT_FILE" \
                                    --alluredir="$ALLURE_RESULTS" \
                                    --clean-alluredir \
                                    --allure-no-capture
                            else
                                .venv/bin/python -m pytest \
                                    test_cases/test_gateway_flow.py \
                                    --project="$PROJECT_ID" \
                                    --target-env="$TARGET_ENV" \
                                    --config-source=platform \
                                    --task-id="$PLATFORM_TASK_ID" \
                                    -s \
                                    --log-cli-level=INFO \
                                    --junitxml="$JUNIT_FILE" \
                                    --alluredir="$ALLURE_RESULTS" \
                                    --clean-alluredir \
                                    --allure-no-capture
                            fi
                        }

                        case "$RUN_TYPE" in
                            single)
                                run_single
                                ;;
                            flow)
                                run_flow
                                ;;
                            all)
                                # 使用一次 pytest 调用，确保单接口失败后仍会继续收集并执行 Flow。
                                if [ -n "$FLOW" ]; then
                                    .venv/bin/python -m pytest \
                                        test_cases/test_single_api.py \
                                        test_cases/test_gateway_flow.py \
                                        --project="$PROJECT_ID" \
                                        --target-env="$TARGET_ENV" \
                                        --config-source=platform \
                                        --task-id="$PLATFORM_TASK_ID" \
                                        --flow="$FLOW" \
                                        -s \
                                        --log-cli-level=INFO \
                                        --junitxml="$JUNIT_FILE" \
                                        --alluredir="$ALLURE_RESULTS" \
                                        --clean-alluredir \
                                        --allure-no-capture
                                else
                                    .venv/bin/python -m pytest \
                                        test_cases/test_single_api.py \
                                        test_cases/test_gateway_flow.py \
                                        --project="$PROJECT_ID" \
                                        --target-env="$TARGET_ENV" \
                                        --config-source=platform \
                                        --task-id="$PLATFORM_TASK_ID" \
                                        -s \
                                        --log-cli-level=INFO \
                                        --junitxml="$JUNIT_FILE" \
                                        --alluredir="$ALLURE_RESULTS" \
                                        --clean-alluredir \
                                        --allure-no-capture
                                fi
                                ;;
                            *)
                                echo "不支持的 RUN_TYPE: $RUN_TYPE"
                                exit 2
                                ;;
                        esac
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                // JUnit 发布异常保持 FAILURE，但继续执行 Allure 发布和产物归档。
                catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                    junit(
                        allowEmptyResults: true,
                        testResults: 'Truthy_ApiAutoTest2/reports/junit/**/*.xml'
                    )
                }

                // 报告工具或 Publisher 异常只标记 UNSTABLE，不覆盖 pytest 的 FAILURE。
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    sh '''
                        set -eu
                        TOOL_ROOT="$WORKSPACE/.jenkins-tools"
                        NODE_HOME="$TOOL_ROOT/node-v$NODE_VERSION-darwin-arm64"
                        ALLURE_HOME="$TOOL_ROOT/allure"
                        ALLURE_BIN="$ALLURE_HOME/bin/allure"
                        # Jenkins 服务可能由不同方式安装 Homebrew，只在当前步骤补充常用路径。
                        export PATH="/opt/homebrew/bin:/usr/local/bin:$NODE_HOME/bin:$ALLURE_HOME/bin:$PATH"
                        NPM_BIN="$(command -v npm || true)"

                        if [ -z "$NPM_BIN" ]; then
                            NODE_ARCHIVE="$TOOL_ROOT/node-v$NODE_VERSION-darwin-arm64.tar.gz"
                            NODE_URL="https://nodejs.org/dist/v$NODE_VERSION/node-v$NODE_VERSION-darwin-arm64.tar.gz"
                            mkdir -p "$TOOL_ROOT"

                            if [ ! -x "$NODE_HOME/bin/npm" ]; then
                                curl --fail --location --retry 3 \
                                    --output "$NODE_ARCHIVE" \
                                    "$NODE_URL"
                                (
                                    cd "$TOOL_ROOT"
                                    echo "$NODE_SHA256  $(basename "$NODE_ARCHIVE")" | \
                                        shasum -a 256 -c -
                                )
                                rm -rf "$NODE_HOME"
                                tar -xzf "$NODE_ARCHIVE" -C "$TOOL_ROOT"
                                rm -f "$NODE_ARCHIVE"
                            fi

                            NPM_BIN="$NODE_HOME/bin/npm"
                            export PATH="$NODE_HOME/bin:$PATH"
                        fi

                        if [ ! -x "$ALLURE_BIN" ] || \
                           [ "$("$ALLURE_BIN" --version)" != "$ALLURE_VERSION" ]; then
                            if [ -z "$NPM_BIN" ]; then
                                echo "未找到 npm，无法准备 Allure CLI"
                                exit 1
                            fi
                            rm -rf "$ALLURE_HOME"
                            "$NPM_BIN" install --global \
                                --prefix "$ALLURE_HOME" \
                                "allure@$ALLURE_VERSION"
                        fi

                        "$ALLURE_BIN" --version
                    '''
                    withEnv([
                        "PATH+NODE=${env.WORKSPACE}/.jenkins-tools/node-v${env.NODE_VERSION}-darwin-arm64/bin:/opt/homebrew/bin:/usr/local/bin",
                        "PATH+ALLURE=${env.WORKSPACE}/.jenkins-tools/allure/bin"
                    ]) {
                        allure(
                            allureVersion: '3',
                            includeProperties: false,
                            resultPolicy: 'LEAVE_AS_IS',
                            results: [[path: "Truthy_ApiAutoTest2/reports/task-reports/${params.PROJECT_ID ?: 'truthy'}/${params.PLATFORM_TASK_ID}/allure-results"]]
                        )
                    }
                }

                // 在项目目录作用域内生成可归档的 HTML 报告，供宿主机拉取脚本同步发布；
                // 生成失败仅标记 UNSTABLE，不覆盖 pytest 的测试结论。
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    dir("${PROJECT_DIR}") {
                        withEnv([
                            "PATH+NODE=${env.WORKSPACE}/.jenkins-tools/node-v${env.NODE_VERSION}-darwin-arm64/bin:/opt/homebrew/bin:/usr/local/bin",
                            "PATH+ALLURE=${env.WORKSPACE}/.jenkins-tools/allure/bin"
                        ]) {
                            sh '''
                                set -eu
                                # 清理上次构建遗留的报告目录，避免旧文件混入本次报告。
                                rm -rf allure-report-publish
                                PROJECT_ID="${PROJECT_ID:-truthy}"
                                ALLURE_RESULTS="reports/task-reports/$PROJECT_ID/$PLATFORM_TASK_ID/allure-results"
                                allure awesome "$ALLURE_RESULTS" --output allure-report-publish
                                # 该文件由 Jenkins 参数和内建构建变量生成，拉取端会
                                # 同时核验 Jenkins API 参数与此归档元数据，禁止调用者
                                # 把任意构建重新贴到其他平台任务名下。
                                python3 - <<'PYEOF'
import json
import os

metadata = {
    "task_id": os.environ["PLATFORM_TASK_ID"],
    "project_id": os.environ.get("PROJECT_ID") or "truthy",
    "build_number": int(os.environ["BUILD_NUMBER"]),
    "job_name": os.environ["JOB_NAME"],
}
with open("allure-report-publish/platform-task-meta.json", "w", encoding="utf-8") as file:
    json.dump(metadata, file, ensure_ascii=False, indent=2)
    file.write("\\n")
PYEOF
                            '''
                        }
                    }
                }
            }

            // 统一在项目目录作用域内归档，归档根固定为 archive/<pattern>，
            // 避免带前缀与不带前缀的 pattern 混用；不含环境文件、虚拟环境或工具目录。
            dir("${PROJECT_DIR}") {
                archiveArtifacts(
                    allowEmptyArchive: true,
                    artifacts: 'logs/**/*,reports/junit/**/*,reports/task-reports/**/*,allure-report-publish/**/*'
                )
            }
        }
    }
}
