# 平台专用凭证模板（【确认项 5】）：复制为 .env.platform 并填写与本地不同的
# 测试账号/会话，避免与本地执行互相写回冲突。禁止把 .env.platform 提交到 Git。
#
# 平台模式将 .env.platform 挂载为容器内 /app/.env（可写）：
# 框架读取凭证并在会话刷新后写回该文件，零框架改动。

# 业务 Gateway 会话（必填）
AUTH_TOKEN=your_access_token
REFRESH_TOKEN=your_refresh_token
USER_ID=your_user_id
DEVICE_ID=your_device_id
EXPIRES_TIME=milliseconds_since_epoch
REFRESH_EXPIRES_TIME=milliseconds_since_epoch

# Admin Gateway 会话（仅运行含 Admin 审计步骤的 Flow 时需要，
# 例如 AnonymousSessionMediaSearch；缺失时相关步骤按框架语义跳过）
ADMIN_SESSION_TOKEN=your_admin_session_token
ADMIN_OPERATOR_ID=your_admin_operator_id
ADMIN_OPERATOR_NAME=your_admin_operator_name
