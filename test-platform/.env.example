# 唯一宿主机端口。
PLATFORM_PORT=8080

# PostgreSQL。共享环境必须替换示例密码。
POSTGRES_DB=test_platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=replace-with-a-strong-password

# 平台运行环境：dev 或 prod。prod 必须同时启用 HTTPS 与 Secure Cookie。
APP_ENV=development
PLATFORM_RUNTIME_ENV=dev
APP_PUBLIC_URL=http://localhost:8080
COOKIE_SECURE=false
LOG_LEVEL=INFO
TOOL_HEALTH_TIMEOUT_SECONDS=3

# 服务端会话和登录保护。
SESSION_IDLE_HOURS=8
SESSION_ABSOLUTE_HOURS=24
LOGIN_FAILURE_LIMIT=5
LOGIN_LOCK_MINUTES=15

# Credential Agent：提前 60 分钟刷新，每 60 秒扫描一次。
CREDENTIAL_REFRESH_WINDOW_SECONDS=3600
CREDENTIAL_AGENT_INTERVAL_SECONDS=60

# 接口自动化工具任务参数。
API_AUTOTEST_TASK_TIMEOUT_SECONDS=1800
API_AUTOTEST_TASKS_RETAIN=50

# 真实凭证撤销/轮换门禁完成前不得改为 platform。
SEARCH_CONFIG_SOURCE=env
API_AUTOTEST_CONFIG_SOURCE=env
API_AUTOTEST_SESSION_PROVIDER=dotenv

# KEK、Bootstrap Token 与每工具 Client Token 只使用 .runtime-secrets/ 文件，
# 不允许在 .env 中保存明文。真实业务 Token 通过 Web Secret 控制面导入。
