# 唯一宿主机端口。
PLATFORM_PORT=8080

# PostgreSQL。共享环境必须替换示例密码。
POSTGRES_DB=test_platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=replace-with-a-strong-password

# 平台运行环境：dev 或 prod。prod 必须同时启用 HTTPS 与 Secure Cookie。
APP_ENV=development
PLATFORM_RUNTIME_ENV=dev
APP_PUBLIC_URL=http://localhost:8080
COOKIE_SECURE=false
LOG_LEVEL=INFO
TOOL_HEALTH_TIMEOUT_SECONDS=3

# 服务端会话和登录保护。
SESSION_IDLE_HOURS=8
SESSION_ABSOLUTE_HOURS=24
LOGIN_FAILURE_LIMIT=5
LOGIN_LOCK_MINUTES=15

# Credential Agent：提前 60 分钟刷新，每 60 秒扫描一次。
CREDENTIAL_REFRESH_WINDOW_SECONDS=3600
CREDENTIAL_AGENT_INTERVAL_SECONDS=60

# 接口自动化工具任务参数。
API_AUTOTEST_TASK_TIMEOUT_SECONDS=1800
API_AUTOTEST_TASKS_RETAIN=50

# 真实凭证撤销/轮换门禁完成前不得改为 platform。
SEARCH_CONFIG_SOURCE=env
API_AUTOTEST_CONFIG_SOURCE=env
API_AUTOTEST_SESSION_PROVIDER=dotenv

# 日志分析独立模式默认 env；平台 Compose 固定为 platform 并通过内部快照读取 LLM。
LOG_FILTER_LLM_CONFIG_SOURCE=env

# KEK、Bootstrap Token 与每工具 Client Token 只使用 .runtime-secrets/ 文件；
# Bootstrap Token 和 Client Token 放在 .runtime-secrets/<environment>/ 下，
# PostgreSQL 卷名也会自动包含 PLATFORM_RUNTIME_ENV，禁止 dev/prod 复用。
# 不允许在 .env 中保存明文。真实业务 Token 通过 Web Secret 控制面导入。
# S2 API 执行默认关闭；只允许在无生产数据的本机 dev 环境显式开启。
API_EXECUTION_ENABLED=false
DATABASE_PERSIST_ENABLED=false
ALLOWED_TARGETS=[]
# Controller 必须看到与宿主一致的绝对路径，且该值不能由浏览器请求覆盖。
API_AGENT_RUNTIME_HOST_ROOT=/Users/admin/Testproject/api-test-agent/runtime/dev/api
# 首次独立发布不登记真实执行目标。
API_EXECUTION_TARGETS=[]
API_EGRESS_TARGETS=[]

# 智能体主 Compose 只消费不可变镜像；本机构建使用 docker-compose.local-build.yml。
AGENT_IMAGE_REGISTRY=
FUNCTIONAL_AGENT_IMAGE=functional-test-agent:0.1.0-local.20260817.f1a6260
API_AGENT_IMAGE=api-test-agent:0.1.0-local.20260817.f1a6260
API_EXECUTION_CONTROLLER_IMAGE=api-execution-controller:0.1.0-local.20260817.f1a6260
API_EGRESS_PROXY_IMAGE=api-egress-proxy:0.1.0-local.20260817.f1a6260
API_EXECUTOR_IMAGE=api-test-executor:0.1.0-local.20260817.f1a6260
FUNCTIONAL_AGENT_REVISION=f1a6260
API_AGENT_REVISION=f1a6260
