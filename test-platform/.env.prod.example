# 真实文件保存为 /srv/test-platform/env/.env.prod，权限必须为 600。
COMPOSE_PROJECT_NAME=test-platform-prod
PLATFORM_PORT=41873
APP_ENV=production
PLATFORM_RUNTIME_ENV=prod
APP_PUBLIC_URL=http://170.106.159.147:41873
COOKIE_SECURE=false
# HTTP + 非 Secure Cookie 仅允许在有可追溯人工风险审批引用时部署；示例保持为空。
SESSION_COOKIE_RISK_ACCEPTANCE_ID=
LOG_LEVEL=INFO
# Prod 只提供只读快照，不反向请求 Dev。
PROD_VERSION_SNAPSHOT_URL=

# 新会话统一 7 天；注册默认开放，可在紧急回滚时改为 disabled。
SESSION_IDLE_HOURS=168
SESSION_ABSOLUTE_HOURS=168
REGISTRATION_MODE=open
REGISTRATION_RATE_LIMIT=5
REGISTRATION_RATE_WINDOW_MINUTES=15
REGISTRATION_LOCK_MINUTES=15
REGISTRATION_GLOBAL_LIMIT=100
REGISTRATION_GLOBAL_WINDOW_MINUTES=15
REGISTRATION_GLOBAL_LOCK_MINUTES=15

# 本轮生产结构预留但保持关闭；不得随 dev 验收自动开启。
PERSONAL_CREDENTIALS_WRITE_ENABLED=false
PERSONAL_CREDENTIALS_ENABLED=false
USER_CONTEXT_TTL_SECONDS=300
RUNTIME_CONTEXT_TTL_SECONDS=86400

POSTGRES_DB=test_platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=replace-with-a-random-production-password

LOG_EXPORT_HOST_DIR=/srv/test-platform/data/log-filter/exports
API_AGENT_RUNTIME_HOST_ROOT=/srv/test-platform/data/api-agent
API_EXECUTION_ENABLED=false
DATABASE_PERSIST_ENABLED=false
ALLOWED_TARGETS=[]
API_EXECUTION_TARGETS=[]
API_EGRESS_TARGETS=[]

# 这些值由 Release 工作流生成的 .env.images 提供，必须是完整 digest，禁止 latest。
POSTGRES_IMAGE=postgres:17-alpine@sha256:742f40ea20b9ff2ff31db5458d127452988a2164df9e17441e191f3b72252193
PLATFORM_GATEWAY_IMAGE=ghcr.io/lnyy-czj/testproject-platform-gateway@sha256:replace-me
PLATFORM_BACKEND_IMAGE=ghcr.io/lnyy-czj/testproject-platform-backend@sha256:replace-me
TRACKEVENTS_IMAGE=ghcr.io/lnyy-czj/testproject-trackevents-web@sha256:replace-me
LOG_FILTER_IMAGE=ghcr.io/lnyy-czj/testproject-log-filter-tool@sha256:replace-me
TRUTHY_SEARCH_IMAGE=ghcr.io/lnyy-czj/testproject-truthy-search@sha256:replace-me
API_AUTOTEST_IMAGE=ghcr.io/lnyy-czj/testproject-api-autotest@sha256:replace-me
FUNCTIONAL_AGENT_IMAGE=ghcr.io/lnyy-czj/testproject-functional-test-agent@sha256:replace-me
API_AGENT_IMAGE=ghcr.io/lnyy-czj/testproject-api-test-agent@sha256:replace-me
API_EXECUTION_CONTROLLER_IMAGE=ghcr.io/lnyy-czj/testproject-api-execution-controller@sha256:replace-me
API_EGRESS_PROXY_IMAGE=ghcr.io/lnyy-czj/testproject-api-egress-proxy@sha256:replace-me
API_EXECUTOR_IMAGE=ghcr.io/lnyy-czj/testproject-api-test-executor@sha256:replace-me
