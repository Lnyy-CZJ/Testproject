# BugAgent 环境变量配置模板
# 复制此文件为 .env 并修改其中的值

# ── 服务配置 ──
BUG_AGENT_SERVER_PORT=8765
BUG_AGENT_SERVER_MODE=debug
BUG_AGENT_SERVER_ADMIN_PASSWORD=admin123

# ── 数据库配置 ──
BUG_AGENT_DATABASE_HOST=localhost
BUG_AGENT_DATABASE_PORT=5432
BUG_AGENT_DATABASE_USER=postgres
BUG_AGENT_DATABASE_PASSWORD=postgres
BUG_AGENT_DATABASE_DBNAME=bug_agent
BUG_AGENT_DATABASE_SCHEMA=public

# ── JWT 配置 ──
BUG_AGENT_JWT_SECRET=bug-agent-secret-key-change-in-production
BUG_AGENT_JWT_EXPIRE_HOUR=72

# ── Redis 配置 ──
BUG_AGENT_REDIS_HOST=localhost
BUG_AGENT_REDIS_PORT=6379
BUG_AGENT_REDIS_PASSWORD=
BUG_AGENT_REDIS_DB=0

# ── 加密密钥 ──
BUG_AGENT_SECRETS_CREDENTIAL_ENCRYPT_KEY=0123456789abcdef0123456789abcdef
BUG_AGENT_SECRETS_AI_CONFIG_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
BUG_AGENT_SECRETS_INVITE_CODE_SIGN_KEY=0123456789abcdef0123456789abcdef