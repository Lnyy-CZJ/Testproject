SEARCH_API_URL=http://****/**/**
SEARCH_HTTP_HEADERS_JSON={
   'Content-Type': 'application/json',
   'Accept': '*/*',
   'Host': 'gateway.spark-jam.top',
   'Connection': 'keep-alive'}
AUTH_TOKEN=""
DEVICE_ID="***"
USER_ID="***"
SEARCH_INPUT_FILE=input/tasks_v01.jsonl
SEARCH_OUTPUT_DIR=output
ALLOW_DUPLICATE_RUN=false
POLL_INTERVAL_SECONDS=5
MAX_POLL_COUNT=60
HTTP_TIMEOUT_SECONDS=30
PLATFORM=ios
APP_VERSION=1.0.0
LOCALE=zh-Hans-CN
TIMEZONE=UTC+08:00

# Excel 单 Run 导出配置；显式 CLI 参数优先于这些值。
