SEARCH_API_URL=http://****/**/**
SEARCH_HTTP_HEADERS_JSON={"Content-Type":"application/json","Accept":"*/*","Host":"gateway.spark-jam.top","Connection":"keep-alive"}
AUTH_TOKEN=""
DEVICE_ID="***"
USER_ID="***"
SEARCH_INPUT_FILE=input/tasks_v01.jsonl
SEARCH_OUTPUT_DIR=output
ALLOW_DUPLICATE_RUN=false
SEARCH_DATA_DIR=data
SEARCH_DB_FILE=data/searchtool_v1_3.db
SEARCH_IMPORT_DIR=data/imports
SEARCH_RAW_DIR=data/raw
SEARCH_REPORT_DIR=output/reports
SEARCH_REPORT_EXCEL_ENABLED=true
SEARCH_WEB_HOST=127.0.0.1
SEARCH_WEB_PORT=5002
# 独立模式保持为空；平台模式由平台 Compose 固定为 /truthy-search。
SEARCH_WEB_BASE_PATH=
# 独立模式保持为空；平台模式由平台 Compose 固定为 /。
PLATFORM_HOME_URL=
SEARCH_DISPLAY_TIMEZONE=Asia/Shanghai
SEARCH_WEB_MAX_UPLOAD_BYTES=52428800
SEARCH_WEB_SECRET_KEY=replace-with-a-local-random-value
POLL_INTERVAL_SECONDS=5
MAX_POLL_COUNT=60
HTTP_TIMEOUT_SECONDS=30
PLATFORM=ios
APP_VERSION=1.0.0
LOCALE=zh-Hans-CN
TIMEZONE=UTC+08:00

# Admin 公共信息采集。平台通过只读 Secret 注入账号；Token 由 Login 获取。
SEARCH_ADMIN_ENABLED=false
SEARCH_ADMIN_LOGIN_API_URL=http://admin-staging.spark-jam.top/admin/invoke
SEARCH_ADMIN_API_URL=http://admin-staging.spark-jam.top/gateway/invoke
SEARCH_ADMIN_HTTP_HEADERS_JSON={"Content-Type":"application/json"}
SEARCH_ADMIN_USERNAME=
SEARCH_ADMIN_PASSWORD=
SEARCH_ADMIN_REASON=searchTool 测试数据采集
SEARCH_ADMIN_DEBUG_SERVICE=worker
SEARCH_ADMIN_COST_LIMIT=100

# 每个输入人物的完整链路日志；平台模式配置为 /app/log 并持久化挂载。
SEARCH_QUERY_LOG_ENABLED=true
SEARCH_QUERY_LOG_DIR=log

# 照片检索执行线。平台照片目录通过现有 /app/input 只读挂载提供。
SEARCH_PHOTO_ENABLED=false
SEARCH_PHOTO_INPUT_DIR=input/input_photos
SEARCH_PHOTO_UPLOAD_HOST_SUFFIXES=.myqcloud.com

# Excel 单 Run 导出配置；显式 CLI 参数优先于这些值。
EXCEL_RESULTS_FILE=
EXCEL_FAILURES_FILE=
EXCEL_OUTPUT_FILE=output/results_comparison.xlsx
EXCEL_RUN_LABEL=candidate
EXCEL_SYSTEM_VERSION=v1.2.0
EXCEL_EVALUATION_ID=eval_YYYYMMDD
EXCEL_METADATA_FILE=

# Excel baseline/candidate 对比配置；compare 模式使用。
EXCEL_BASELINE_RESULTS_FILE=
EXCEL_BASELINE_FAILURES_FILE=
EXCEL_BASELINE_VERSION=
EXCEL_CANDIDATE_RESULTS_FILE=
EXCEL_CANDIDATE_FAILURES_FILE=
EXCEL_CANDIDATE_VERSION=
