# 仅 Controller 持有 Docker Socket；Web 与 Executor 均不使用本镜像。
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements-execution-controller.lock ./
RUN pip install --no-cache-dir -r requirements-execution-controller.lock \
    && useradd --create-home --uid 10004 controller
COPY --chown=controller:controller services ./services
EXPOSE 5010
CMD ["gunicorn", "services.execution_controller.app:create_app()", "--bind", "0.0.0.0:5010", "--workers", "1", "--threads", "4", "--access-logfile", "-", "--error-logfile", "-"]
