# 固定 Executor 不包含模型、数据库、平台 SDK、Shell 入口或凭据。
FROM python:3.12-slim

ARG APP_REVISION=unknown
ARG APP_VERSION=unknown
ARG APP_BUILD_DIRTY=true
LABEL org.opencontainers.image.version=$APP_VERSION \
      org.opencontainers.image.revision=$APP_REVISION
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_REVISION=${APP_REVISION} \
    APP_VERSION=${APP_VERSION} \
    APP_BUILD_DIRTY=${APP_BUILD_DIRTY}
WORKDIR /app
RUN useradd --no-create-home --uid 10003 executor
COPY --chown=executor:executor executor/runner.py /app/runner.py
USER executor
ENTRYPOINT ["python", "/app/runner.py"]
