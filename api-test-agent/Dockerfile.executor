# 固定 Executor 不包含模型、数据库、平台 SDK、Shell 入口或凭据。
FROM python:3.12-slim

ARG APP_REVISION=unknown
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_REVISION=${APP_REVISION}
WORKDIR /app
RUN useradd --no-create-home --uid 10003 executor
COPY --chown=executor:executor executor/runner.py /app/runner.py
USER executor
ENTRYPOINT ["python", "/app/runner.py"]
