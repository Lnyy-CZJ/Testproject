# Egress 只包含目标策略和标准库，不包含平台、模型或数据库凭据。
FROM python:3.12-slim

ARG APP_REVISION=unknown
ARG APP_VERSION=unknown
ARG APP_BUILD_DIRTY=true
LABEL org.opencontainers.image.version=$APP_VERSION \
      org.opencontainers.image.revision=$APP_REVISION
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    APP_REVISION=${APP_REVISION} \
    APP_VERSION=${APP_VERSION} \
    APP_BUILD_DIRTY=${APP_BUILD_DIRTY}
WORKDIR /app
RUN useradd --no-create-home --uid 10005 egress
COPY --chown=egress:egress services/__init__.py ./services/__init__.py
COPY --chown=egress:egress services/egress_proxy ./services/egress_proxy
COPY --chown=egress:egress services/execution_controller/__init__.py ./services/execution_controller/__init__.py
COPY --chown=egress:egress services/execution_controller/policies.py ./services/execution_controller/policies.py
USER egress
EXPOSE 5011
ENTRYPOINT ["python", "-m", "services.egress_proxy.app"]
